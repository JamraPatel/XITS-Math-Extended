feature ccmp {
# GSUB feature: Glyph Composition / Decomposition
# Lookups: 3

  sub [sinnyiiyhe-adlam kaf-adlam jiim-adlam tu-adlam kha-adlam zal-adlam sha-adlam] gemination-adlam' by gemination-adlam.wide;

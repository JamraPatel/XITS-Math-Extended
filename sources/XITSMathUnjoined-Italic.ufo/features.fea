feature ccmp {
# GSUB feature: Glyph Composition / Decomposition
# Lookups: 3

  sub [sinnyiiyhe-adlam kaf-adlam jiim-adlam tu-adlam kha-adlam zal-adlam sha-adlam] gemination-adlam' by gemination-adlam.wide;
  sub @ccmp [aliflengthencomb-adlam vowellengthencomb-adlam gemination-adlam gemination-adlam.wide]' by [aliflengthencomb-adlam.case vowellengthencomb-adlam.case gemination-adlam.case gemination-adlam.wide.case];

  script latn; # Latin

  script adlm;
  sub percent by percent.adlam;
  sub perthousand by perthousand.adlam;

  script math; # Mathematical Alphanumeric Symbols

  script nko ; # N'Ko
  sub space by space.nko;
  sub percent by percent.nko;
  sub parenleft by parenleft.nko;
  sub parenright by parenright.nko;
  sub bracketleft by bracketleft.nko;
  sub bracketright by bracketright.nko;
  sub perthousand by perthousand.nko;

} ccmp;

